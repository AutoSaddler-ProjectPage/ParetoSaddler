  }
  .promotion-announcement {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    overflow: hidden;
    clip-path: inset(50%);
  }
  button:disabled,
  input:disabled {
    opacity: 0.5;
    cursor: default;
  }
  @media (max-width: 680px) {
