---
import { promotionEvidence } from "../data/promotion-evidence";
---

<section
  id="promotion-demo"
  class="promotion-demo research-figure"
  aria-labelledby="promotion-demo-title"
>
  <div class="promotion-heading">
    <div>
      <h3 id="promotion-demo-title">Promotion Evidence</h3>
    </div>
  </div>
  <div class="promotion-layout">
    <div class="promotion-distribution">
      <svg
        viewBox="0 0 560 350"
        class="promotion-plot"
        role="img"
        aria-labelledby="promotion-plot-title promotion-plot-desc"
      >
        <title id="promotion-plot-title">
          Bayesian bootstrap changes in quality and cost for ClawMark I-12
        </title>
        <desc id="promotion-plot-desc"
          >Green regions support promotion: quality improves, or cost decreases
          with a quality loss of at most 10 percentage points. Each dot is one
          of 500 displayed draws from 10,000 draws recomputed using rounded
          observations.</desc
        >
        <defs
          ><clipPath id="promotion-plot-clip"
            ><rect x="64" y="32" width="464" height="254"></rect></clipPath
          ></defs
        >
        <rect
          x="64"
          y="32"
          width="464"
          height="254"
          class="promotion-plot-field"></rect>
        <g clip-path="url(#promotion-plot-clip)">
          <rect
            x="64"
            y="32"
            width="464"
            height="127"
            class="promotion-support-region"></rect>
          <rect
            x="64"
            y="159"
            width="232"
            height="42.3333"
            class="promotion-support-region"></rect>
          <g class="promotion-grid">
            {
              [-40, -20, 0, 20, 40].map((tick) => (
                <line
                  x1={64 + (tick + 50) * 4.64}
                  x2={64 + (tick + 50) * 4.64}
                  y1="32"
                  y2="286"
                />
              ))
            }
            {
              [-20, -10, 0, 10, 20].map((tick) => (
                <line
                  x1="64"
                  x2="528"
                  y1={286 - ((tick + 30) * 254) / 60}
                  y2={286 - ((tick + 30) * 254) / 60}
                />
              ))
            }
          </g>
          <path class="promotion-zero" d="M64 159H528M296 32V286"></path>
          <path class="promotion-allowance" d="M64 201.3333H296"></path>
          <g data-promotion-cloud></g>
          <circle
            data-promotion-current
            r="5"
            class="promotion-current"
            visibility="hidden"></circle>
        </g>
        <path class="promotion-axis" d="M64 32V286H528"></path>
        {
          [-40, -20, 0, 20, 40].map((tick) => (
            <text x={64 + (tick + 50) * 4.64} y="307" text-anchor="middle">
              {tick > 0 ? "+" : ""}
              {tick}%
            </text>
          ))
        }
        {
          [-20, -10, 0, 10, 20].map((tick) => (
            <text x="54" y={291 - ((tick + 30) * 254) / 60} text-anchor="end">
              {tick > 0 ? "+" : ""}
              {tick}
            </text>
          ))
        }
        <text x="296" y="337" text-anchor="middle"
          >Relative cost change · lower is better</text
        >
        <text transform="translate(17 159) rotate(-90)" text-anchor="middle"
          >Quality change (pp)</text
        >
        <text x="77" y="50" class="promotion-region-label"
          >Quality improves</text
        >
        <text x="77" y="222" class="promotion-limit-label"
          >−10 pp quality-loss allowance</text
        >
      </svg>
      <div class="promotion-plot-legend">
        <span><i class="promotion-support-key"></i>Supports promotion</span
        ><span><i></i>Does not support</span>
      </div>

      <div class="promotion-playback">
        <button
          class="promotion-play"
          type="button"
          data-promotion-play
          disabled>Play</button
        >
        <div class="promotion-timeline">
          <label for="promotion-draws"
            >Draws <output data-promotion-draw-count>0 / 10,000</output></label
          >
          <input
            id="promotion-draws"
            data-promotion-scrub
            type="range"
            min="0"
            max="10000"
            value="0"
            step="1"
            disabled
            aria-label="Scrub bootstrap draws"
          />
        </div>
      </div>
    </div>
    <aside
      class="promotion-reading"
      aria-label="Promotion support and decision"
    >
      <div class="promotion-support-value">
        <span>Support <i>p̂</i></span>
        <strong data-promotion-support>—</strong>
      </div>
      <div class="promotion-gate">
        <label for="promotion-threshold"
          >Threshold <i>γ</i><output data-promotion-threshold-value>0.70</output
          ></label
        >
        <div class="promotion-threshold-control">
          <span class="promotion-support-tick" aria-hidden="true"></span>
          <input
            id="promotion-threshold"
            data-promotion-threshold
            type="range"
            min="0"
            max="1"
            value="0.7"
            step="0.01"
            disabled
          />
        </div>
        <span class="promotion-adjust-hint">Drag to adjust the threshold</span>
      </div>
      <div class="promotion-conclusion">
        <span class="promotion-comparison" data-promotion-comparison>p̂ ≥ γ</span
        >
        <div class="promotion-decision" data-promotion-decision>
          Waiting for evidence
        </div>
        <p class="promotion-explanation" data-promotion-explanation>
          Reweighting the parent and candidate observations to estimate support.
        </p>
      </div>
      <p class="promotion-case-note">
        Mean cost falls 7.19%, with a 5.55 pp quality loss. The mean-based gate
        would pass this update.
      </p>
    </aside>
  </div>
  <details class="promotion-evidence-panel">
    <summary
      >Inspect the observations <span>3 tasks · 3 runs per harness</span
      ></summary
    >
    <div class="promotion-evidence">
      <div
        class="promotion-task-switch figure-tabs figure-tabs--compact"
        role="group"
        aria-label="Inspect screening task"
      >
        {
          promotionEvidence.map((task, index) => (
            <button
              type="button"
              data-promotion-task={index}
              aria-pressed={index === 0}
            >
              {task.name}
            </button>
          ))
        }
      </div>
      <div class="promotion-observations">
        <div class="promotion-run-heading">
          <span>Quality / cost</span><span data-promotion-weight-draw
            >Equal weights</span
          >
        </div>
        {
          (["parent", "candidate"] as const).map((side) => (
            <div class="promotion-harness" data-promotion-harness={side}>
              <h4>{side === "parent" ? "Parent" : "Candidate I-12"}</h4>
              {promotionEvidence[0][side].map(([quality, cost], run) => (
                <div class="promotion-run" data-promotion-run={run}>
                  <span class="promotion-run-index">R{run + 1}</span>
                  <span data-promotion-observation>
                    {quality}% / ${cost.toFixed(2)}
                  </span>
                  <div class="promotion-weight" aria-hidden="true">
                    <i style="transform: scaleX(0.333333)" />
                  </div>
                  <span data-promotion-weight>⅓</span>
                </div>
              ))}
            </div>
          ))
        }
      </div>
      <p class="promotion-weight-note">
        One weight per execution, shared by its quality and cost. Tasks
        contribute equally.
      </p>
    </div>
  </details>
  <p class="promotion-announcement" role="status" data-promotion-announcement>
  </p>
  <noscript
    ><p>
      I-12 does not meet the default promotion threshold γ = 0.70.
    </p></noscript
  >
</section>

<script>
  import { observeChartTypography } from "../lib/figure-typography";
  import {
    promotionEvidence,
    bootstrapPromotion,
  } from "../data/promotion-evidence";
  const root = document.querySelector<HTMLElement>(".promotion-demo");
  if (root) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const play = root.querySelector<HTMLButtonElement>(
      "[data-promotion-play]",
    )!;
    const scrub = root.querySelector<HTMLInputElement>(
      "[data-promotion-scrub]",
    )!;
    const threshold = root.querySelector<HTMLInputElement>(
      "[data-promotion-threshold]",
    )!;
    const cloud = root.querySelector<SVGGElement>("[data-promotion-cloud]")!;
    const current = root.querySelector<SVGCircleElement>(
      "[data-promotion-current]",
    )!;
    const details = root.closest("details")!;
    let data: ReturnType<typeof bootstrapPromotion> | null = null;
    let dots: SVGCircleElement[] = [];
    let drawCount = 0,
      task = 0,
      frame = 0,
      start = 0,
      previousWeightDraw = -1;
    let hasPlayed = false,
      playing = false;
    const text = (selector: string, value: string) => {
      root.querySelector(selector)!.textContent = value;
    };
    const setPlayLabel = (label: string) => {
      play.textContent = label;
      play.title = label;
      play.setAttribute("aria-label", label);
    };
    const initialize = () => {
      if (data) return;
      data = bootstrapPromotion();
      const fragment = document.createDocumentFragment();
      dots = data.draws
        .filter((_, index) => index % 20 === 0)
        .map((draw) => {
          const dot = document.createElementNS(
            "http://www.w3.org/2000/svg",
            "circle",
          );
          dot.setAttribute("cx", String(64 + (draw.cost + 50) * 4.64));
          dot.setAttribute(
            "cy",
            String(286 - ((draw.quality + 30) * 254) / 60),
          );
          dot.setAttribute("r", "2.1");
          dot.setAttribute(
            "class",
            draw.passes ? "promotion-draw supports" : "promotion-draw",
          );
          dot.setAttribute("visibility", "hidden");
          fragment.append(dot);
          return dot;
        });
      cloud.append(fragment);
      play.disabled = scrub.disabled = threshold.disabled = false;
    };
    const showWeights = (index: number) => {
      text(
        "[data-promotion-weight-draw]",
        index < 0
          ? "Equal weights"
          : `Draw ${(index + 1).toLocaleString("en-US")} weights`,
      );
      const weights =
        index < 0
          ? [
              [1 / 3, 1 / 3, 1 / 3],
              [1 / 3, 1 / 3, 1 / 3],
            ]
          : data!.draws[index].weights[task];
      root
        .querySelectorAll<HTMLElement>("[data-promotion-harness]")
        .forEach((group, side) => {
          group
            .querySelectorAll<HTMLElement>("[data-promotion-run]")
            .forEach((row, run) => {
              const w = weights[side][run];
              row.querySelector<HTMLElement>(
                ".promotion-weight i",
              )!.style.transform = `scaleX(${w})`;
              row.querySelector("[data-promotion-weight]")!.textContent =
                `${Math.round(w * 100)}%`;
              const [q, c] =
                promotionEvidence[task][side ? "candidate" : "parent"][run];
              row.querySelector("[data-promotion-observation]")!.textContent =
                `${q}% / $${c.toFixed(2)}`;
            });
        });
    };
    const render = () => {
      if (!data) return;
      root.dataset.drawCount = String(drawCount);
      scrub.value = String(drawCount);
      scrub.setAttribute(
        "aria-valuetext",
        `${drawCount.toLocaleString("en-US")} of 10,000 bootstrap draws`,
      );
      text(
        "[data-promotion-draw-count]",
        `${drawCount.toLocaleString("en-US")} / 10,000`,
      );
      const support = drawCount ? data.supported[drawCount] / drawCount : 0;
      const gamma = Number(threshold.value);
      const complete = drawCount === 10000;
      text("[data-promotion-support]", drawCount ? support.toFixed(2) : "—");
      text("[data-promotion-threshold-value]", gamma.toFixed(2));
      root
        .querySelector<HTMLElement>(".promotion-gate")!
        .style.setProperty("--support", `${support * 100}%`);
      text(
        "[data-promotion-comparison]",
        drawCount
          ? `${support.toFixed(2)} ${support >= gamma ? "≥" : "<"} ${gamma.toFixed(2)}`
          : "p̂ ≥ γ",
      );
      const decision = root.querySelector<HTMLElement>(
        "[data-promotion-decision]",
      )!;
      decision.dataset.result = complete
        ? support >= gamma
          ? "promote"
          : "hold"
        : "pending";
      decision.textContent = complete
        ? support >= gamma
          ? "Promote → development"
          : "Do not promote"
        : drawCount
          ? "Collecting support…"
          : "Waiting for evidence";
      dots.forEach((dot, index) => {
        const visible = index * 20 < drawCount;
        dot.setAttribute("visibility", visible ? "visible" : "hidden");
        dot.style.opacity = visible
          ? data!.draws[index * 20].passes
            ? "0.65"
            : "0.42"
          : "0";
      });
      const weightIndex = drawCount
        ? Math.min(9999, Math.floor((drawCount - 1) / 500) * 500)
        : -1;
      if (weightIndex !== previousWeightDraw) {
        showWeights(weightIndex);
        previousWeightDraw = weightIndex;
      }
      current.setAttribute(
        "visibility",
        drawCount &&
          !complete &&
          root.querySelector<HTMLDetailsElement>(".promotion-evidence-panel")!
            .open
          ? "visible"
          : "hidden",
      );
      if (drawCount) {
        const draw = data.draws[weightIndex];
        current.setAttribute("cx", String(64 + (draw.cost + 50) * 4.64));
        current.setAttribute(
          "cy",
          String(286 - ((draw.quality + 30) * 254) / 60),
        );
      }
      text(
        "[data-promotion-explanation]",
        complete
          ? support >= gamma
            ? "The candidate advances to development evaluation at this threshold."
            : "The repeated evidence does not meet the promotion threshold."
          : "Reweighting the parent and candidate observations to estimate support.",
      );
    };
    const pause = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      playing = false;
      play.dataset.playing = "false";
      setPlayLabel(
        drawCount === 10000 ? "Replay" : drawCount ? "Continue" : "Play",
      );
    };
    const finish = () => {
      pause();
      drawCount = 10000;
      render();
      setPlayLabel("Replay");
      text(
        "[data-promotion-announcement]",
        root.querySelector("[data-promotion-decision]")!.textContent!,
      );
    };
    const tick = (now: number) => {
      const elapsed = now - start;
      drawCount = Math.max(
        0,
        Math.min(10000, Math.floor(((elapsed - 650) / 3600) * 10000)),
      );
      render();
      if (drawCount === 10000) finish();
      else frame = requestAnimationFrame(tick);
    };
    const begin = () => {
      initialize();
      hasPlayed = true;
      text("[data-promotion-announcement]", "");
      if (reduced.matches) {
        finish();
        return;
      }
      if (drawCount === 10000) drawCount = 0;
      playing = true;
      play.dataset.playing = "true";
      start =
        performance.now() - (drawCount ? 650 + (drawCount / 10000) * 3600 : 0);
      setPlayLabel("Pause");
      frame = requestAnimationFrame(tick);
    };
    play.addEventListener("click", () => (playing ? pause() : begin()));
    scrub.addEventListener("input", () => {
      pause();
      hasPlayed = true;
      drawCount = Number(scrub.value);
      render();
      pause();
    });
    threshold.addEventListener("input", () => {
      render();
      if (drawCount === 10000)
        text(
          "[data-promotion-announcement]",
          root.querySelector("[data-promotion-decision]")!.textContent!,
        );
    });
    root
      .querySelectorAll<HTMLButtonElement>("[data-promotion-task]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          task = Number(button.dataset.promotionTask);
          root
            .querySelectorAll("[data-promotion-task]")
            .forEach((element) =>
              element.setAttribute("aria-pressed", String(element === button)),
            );
          showWeights(previousWeightDraw);
        });
      });
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries[0].isIntersecting;
        if (visible && details.open && !hasPlayed) begin();
        else if (!visible && playing) pause();
      },
      { threshold: 0.25 },
    );
    observer.observe(root.querySelector(".promotion-distribution")!);
    details.addEventListener("toggle", () => {
      if (details.open) initialize();
      else pause();
    });
    document.addEventListener("visibilitychange", () => {
      if (document.hidden && playing) pause();
    });
    reduced.addEventListener("change", () => {
      if (reduced.matches && data) finish();
    });
    observeChartTypography(
      root.querySelector<SVGSVGElement>(".promotion-plot")!,
      {
        compactAxis: { x: -4, y: 159 },
      },
    );
    setPlayLabel("Play");
    // Initialize controls even if the details was opened by a restored browser state.
    if (details.open) initialize();
  }
</script>

<style>
  .promotion-demo {
    margin: 18px 0 22px;
    color: var(--ink);
    --figure-rule: #dedfd8;
    --figure-muted: #777c73;
  }
  .promotion-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }
  .promotion-kicker {
    color: var(--figure-muted);
    font-size: 12px;
  }
  .promotion-heading h3 {
    margin: 7px 0 0;
  }
  .promotion-reference {
    font-size: 11px;
    color: var(--figure-muted);
    padding-bottom: 3px;
  }
  .promotion-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 230px;
    gap: 48px;
    align-items: start;
  }
  .promotion-distribution {
    min-width: 0;
  }
  .promotion-plot {
    display: block;
    width: 100%;
    overflow: visible;
  }
  .promotion-plot-field {
    fill: #fbfbf8;
  }
  .promotion-support-region {
    fill: #eef2e9;
  }
  .promotion-grid line {
    stroke: #e9eae3;
    stroke-width: 0.65;
  }
  .promotion-zero {
    stroke: #bfc6ba;
    stroke-width: 0.85;
  }
  .promotion-axis {
    fill: none;
    stroke: #c9ccc2;
    stroke-width: 0.8;
  }
  .promotion-allowance {
    fill: none;
    stroke: #8e9b84;
    stroke-width: 0.85;
    stroke-dasharray: 3 4;
  }
  .promotion-plot text {
    font: 10px var(--font-sans);
    fill: #72786b;
  }
  .promotion-plot .promotion-region-label {
    font-size: 10px;
    fill: #62755b;
  }
  .promotion-plot .promotion-limit-label {
    font-size: 9px;
  }
  .promotion-distribution :global(.promotion-draw) {
    fill: #9d9b8b;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .promotion-distribution :global(.promotion-draw.supports) {
    fill: #4b7252;
  }
  .promotion-current {
    fill: #263f2c;
    stroke: white;
    stroke-width: 1.5;
  }
  .promotion-plot-legend {
    display: flex;
    justify-content: center;
    gap: 20px;
    font-size: 10px;
    color: var(--figure-muted);
    margin-top: 3px;
  }
  .promotion-plot-legend i {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #9d9b8b;
    margin-right: 5px;
  }
  .promotion-plot-legend .promotion-support-key {
    background: #4b7252;
  }
  .promotion-playback {
    display: flex;
    align-items: center;
    gap: 25px;
    margin: 25px 0 0 11.4%;
  }
  .promotion-play {
    border: 0;
    background: none;
    color: var(--ink);
    font-size: 12px;
    text-align: left;
    padding: 0;
    min-height: 44px;
    min-width: 58px;
  }
  .promotion-play::before {
    content: "";
    display: inline-block;
    width: 0;
    height: 0;
    border-left: 5px solid currentColor;
    border-block: 3px solid transparent;
    margin-right: 9px;
  }
  .promotion-play[data-playing="true"]::before {
    width: 5px;
    height: 7px;
    border: 0;
    border-inline: 1.5px solid currentColor;
  }
  :global(.promotion-equations > summary) {
    font-size: 12px;
    font-weight: 400;
    color: var(--muted);
    padding: 11px 0;
  }
  :global(.promotion-equations > div) {
    font-size: 14px;
    color: var(--muted);
    padding-bottom: 18px;
  }
  .promotion-timeline {
    flex: 1;
    min-width: 0;
  }
  .promotion-demo label {
    display: flex;
    align-items: baseline;
    gap: 5px;
    color: var(--figure-muted);
    font-size: 11px;
  }
  .promotion-demo label output {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }
  .promotion-demo input[type="range"] {
    appearance: none;
    -webkit-appearance: none;
    display: block;
    background: transparent;
    width: 100%;
    margin: 0;
    min-width: 0;
    height: 26px;
    cursor: pointer;
  }
  .promotion-demo input[type="range"]::-webkit-slider-runnable-track {
    height: 1px;
    background: #bfc5b9;
  }
  .promotion-demo input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 9px;
    height: 9px;
    margin-top: -4px;
    background: #394b38;
    border: 0;
    border-radius: 50%;
  }
  .promotion-demo input[type="range"]::-moz-range-track {
    height: 1px;
    background: #bfc5b9;
  }
  .promotion-demo input[type="range"]::-moz-range-thumb {
    width: 9px;
    height: 9px;
    background: #394b38;
    border: 0;
    border-radius: 50%;
  }
  .promotion-reading {
    padding-top: 31px;
  }
  .promotion-support-value > span {
    display: block;
    color: var(--figure-muted);
    font-size: 12px;
  }
  .promotion-support-value i,
  .promotion-gate i {
    font-family: Georgia, serif;
  }
  .promotion-support-value strong {
    display: block;
    color: #303d2d;
    font-size: 72px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.065em;
    line-height: 1.3;
    margin: 4px 0 24px;
  }
  .promotion-gate {
    --support: 0%;
  }
  .promotion-gate label {
    font-size: 12px;
    color: var(--ink);
  }
  .promotion-gate output {
    font-size: 16px;
  }
  .promotion-threshold-control {
    position: relative;
  }
  .promotion-support-tick {
    position: absolute;
    top: 8px;
    height: 10px;
    left: clamp(4px, var(--support), calc(100% - 4px));
    width: 1px;
    background: #7d8d70;
    pointer-events: none;
  }
  .promotion-adjust-hint {
    display: block;
    font-size: 10px;
    color: var(--figure-muted);
    margin-top: -1px;
  }
  .promotion-conclusion {
    margin-top: 26px;
    padding-top: 18px;
  }
  .promotion-comparison {
    display: block;
    font-size: 12px;
    color: var(--figure-muted);
    font-variant-numeric: tabular-nums;
    margin-bottom: 6px;
  }
  .promotion-decision {
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.025em;
  }
  .promotion-decision[data-result="promote"] {
    color: #38613f;
  }
  .promotion-demo .promotion-explanation {
    font-size: 12px;
    color: var(--figure-muted);
    margin: 8px 0 0;
