    color: var(--ink);
    margin: 0;
  }
  .promotion-rule {
    font-size: 16px;
    line-height: 1.7;
    margin: 0 0 16px;
    color: var(--muted);
  }
  .promotion-rule strong {
    color: var(--ink);
  }
  .promotion-layout {
    display: grid;
    grid-template-columns: minmax(0, 420px) minmax(0, 240px);
    justify-content: center;
    gap: 32px;
    align-items: center;
  }
  .promotion-distribution {
    min-width: 0;
    max-width: 420px;
  }
  .promotion-plot {
    display: block;
    width: 100%;
    overflow: visible;
  }
  .promotion-plot-field {
    fill: #fff;
  }
  .promotion-support-region {
    fill: var(--pale);
  }
  .promotion-grid line {
    stroke: #e8ede8;
    stroke-width: 0.65;
  }
  .promotion-zero {
    stroke: #bfcac1;
    stroke-width: 0.85;
  }
  .promotion-axis {
    fill: none;
    stroke: #bfcac1;
    stroke-width: 0.8;
  }
  .promotion-allowance {
    fill: none;
    stroke: #8ba18f;
    stroke-width: 0.85;
    stroke-dasharray: 3 4;
  }
  .promotion-plot text {
    font: 12px var(--font-sans);
    fill: var(--muted);
  }
  .promotion-plot .promotion-region-label {
    fill: var(--green);
  }
  .promotion-distribution :global(.promotion-draw) {
    fill: #9d9b8b;
    opacity: 0.42;
  }
  .promotion-distribution :global(.promotion-draw.supports) {
    fill: var(--green);
    opacity: 0.65;
  }
  .promotion-plot-legend {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-top: 0;
    color: var(--muted);
  }
  .promotion-plot-legend i {
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-right: 5px;
    border-radius: 50%;
    background: #9d9b8b;
  }
  .promotion-plot-legend .promotion-support-key {
    background: var(--green);
  }
  .promotion-playback {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 10px 0 0 11.4%;
  }
  .promotion-play::before {
    content: "";
    display: block;
    width: 0;
    height: 0;
    border-left: 8px solid currentColor;
    border-block: 5px solid transparent;
  }
  .promotion-timeline {
    flex: 1;
    min-width: 0;
  }
  .promotion-demo label {
    display: flex;
    align-items: baseline;
    gap: 5px;
  }
  .promotion-demo label output {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }
  .promotion-demo input[type="range"] {
    appearance: none;
    -webkit-appearance: none;
    display: block;
    width: 100%;
    height: 30px;
    background: transparent;
    margin: 0;
    cursor: pointer;
  }
  .promotion-demo input[type="range"]::-webkit-slider-runnable-track {
    height: 2px;
    background: var(--line);
  }
  .promotion-demo input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 10px;
    height: 10px;
    margin-top: -4px;
    background: var(--green);
    border: 0;
    border-radius: 50%;
  }
  .promotion-demo input[type="range"]::-moz-range-track {
    height: 2px;
    background: var(--line);
  }
  .promotion-demo input[type="range"]::-moz-range-thumb {
    width: 10px;
    height: 10px;
    background: var(--green);
    border: 0;
    border-radius: 50%;
  }
  .promotion-reading {
    min-width: 0;
