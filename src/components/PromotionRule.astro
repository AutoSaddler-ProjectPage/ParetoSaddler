<section
  id="promotion-demo"
  class="promotion-demo research-figure"
  aria-label="Statistical promotion rule illustration"
>
  <p class="promotion-rule">
    Bayesian bootstrap reweights repeated runs. Count draws where
    <strong>quality improves</strong>, or
    <strong>cost falls with at most 10 pp quality loss</strong>.
  </p>
  <div class="promotion-layout">
    <div class="promotion-distribution">
      <svg
        viewBox="0 0 560 350"
        class="promotion-plot"
        role="img"
        aria-labelledby="promotion-plot-title promotion-plot-desc"
      >
        <title id="promotion-plot-title">
          Bayesian bootstrap changes in quality and cost for ClawMark I-12
        </title>
        <desc id="promotion-plot-desc"
          >Green regions support promotion: quality improves, or cost decreases
          with a quality loss of at most 10 percentage points. Each dot is one
          of 500 displayed draws from 10,000 draws recomputed using rounded
          observations.</desc
        >
        <defs
          ><clipPath id="promotion-plot-clip"
            ><rect x="64" y="32" width="464" height="254"></rect></clipPath
          ></defs
        >
        <rect
          x="64"
          y="32"
          width="464"
          height="254"
          class="promotion-plot-field"></rect>
        <g clip-path="url(#promotion-plot-clip)">
          <rect
            x="64"
            y="32"
            width="464"
            height="127"
            class="promotion-support-region"></rect>
          <rect
            x="64"
            y="159"
            width="232"
            height="42.3333"
            class="promotion-support-region"></rect>
          <g class="promotion-grid">
            {
              [-40, -20, 0, 20, 40].map((tick) => (
                <line
                  x1={64 + (tick + 50) * 4.64}
                  x2={64 + (tick + 50) * 4.64}
                  y1="32"
                  y2="286"
                />
              ))
            }
            {
              [-20, -10, 0, 10, 20].map((tick) => (
                <line
                  x1="64"
                  x2="528"
                  y1={286 - ((tick + 30) * 254) / 60}
                  y2={286 - ((tick + 30) * 254) / 60}
                />
              ))
            }
          </g>
          <path class="promotion-zero" d="M64 159H528M296 32V286"></path>
          <path class="promotion-allowance" d="M64 201.3333H296"></path>
          <g data-promotion-cloud></g>
        </g>
        <path class="promotion-axis" d="M64 32V286H528"></path>
        {
          [-40, -20, 0, 20, 40].map((tick) => (
            <text x={64 + (tick + 50) * 4.64} y="307" text-anchor="middle">
              {tick > 0 ? "+" : ""}
              {tick}%
            </text>
          ))
        }
        {
          [-20, -10, 0, 10, 20].map((tick) => (
            <text x="54" y={291 - ((tick + 30) * 254) / 60} text-anchor="end">
              {tick > 0 ? "+" : ""}
              {tick}
            </text>
          ))
        }
        <text x="296" y="337" text-anchor="middle">ΔC</text>
        <text transform="translate(17 159) rotate(-90)" text-anchor="middle"
          >ΔQ</text
        >
        <text x="77" y="50" class="promotion-region-label"
          >Quality improves</text
        >
        <text x="77" y="222" class="promotion-limit-label"
          >−10 pp quality-loss allowance</text
        >
      </svg>
      <div class="promotion-plot-legend">
        <span><i class="promotion-support-key"></i>Supports promotion</span>
        <span><i></i>Does not support</span>
      </div>
      <div class="promotion-playback">
        <button
          class="promotion-play"
          type="button"
          data-promotion-play
          disabled>Play</button
        >
        <div class="promotion-timeline">
          <label for="promotion-draws"
            >Draws <output data-promotion-draw-count>0 / 10,000</output></label
          >
          <input
            id="promotion-draws"
            data-promotion-scrub
            type="range"
            min="0"
            max="10000"
            value="0"
            step="1"
            disabled
            aria-label="Scrub bootstrap draws"
          />
        </div>
      </div>
    </div>
    <aside
      class="promotion-reading"
      aria-label="Promotion support and decision"
    >
      <div class="promotion-support-value">
        <span>Support <i>p̂</i></span>
        <strong data-promotion-support>—</strong>
      </div>
      <div class="promotion-gate">
        <label for="promotion-threshold"
          >Threshold <i>γ</i><output data-promotion-threshold-value>0.70</output
          ></label
        >
        <div class="promotion-threshold-control">
          <span class="promotion-support-tick" aria-hidden="true"></span>
          <input
            id="promotion-threshold"
            data-promotion-threshold
            type="range"
            min="0"
            max="1"
            value="0.7"
            step="0.01"
            disabled
          />
        </div>
      </div>
      <div class="promotion-conclusion">
        <span class="promotion-comparison" data-promotion-comparison
          >Promote when p̂ ≥ γ</span
        >
        <div class="promotion-decision" data-promotion-decision>
          Waiting for evidence
        </div>
      </div>
      <p class="promotion-settings">
        3 runs per task · 10,000 draws · no local cost cap.
      </p>
    </aside>
  </div>
  <p
    class="promotion-announcement"
    role="status"
    aria-live="polite"
    data-promotion-announcement
  >
  </p>
  <noscript
    ><p>
      The paper reports p̂ = 0.55 &lt; γ = 0.70: do not promote I-12.
    </p></noscript
  >
</section>

<script>
  import { observeChartTypography } from "../lib/figure-typography";
  import { bootstrapPromotion } from "../data/promotion-evidence";

  const root = document.querySelector<HTMLElement>("#promotion-demo");
  if (root) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const details = root.closest("details")!;
    const play = root.querySelector<HTMLButtonElement>(
      "[data-promotion-play]",
    )!;
    const scrub = root.querySelector<HTMLInputElement>(
      "[data-promotion-scrub]",
    )!;
    const threshold = root.querySelector<HTMLInputElement>(
      "[data-promotion-threshold]",
    )!;
    const cloud = root.querySelector<SVGGElement>("[data-promotion-cloud]")!;
    let data: ReturnType<typeof bootstrapPromotion> | null = null;
    let dots: SVGCircleElement[] = [];
    let drawCount = 0,
      visibleDots = 0,
      frame = 0,
      start = 0;
    let hasPlayed = false,
      playing = false;
    const text = (selector: string, value: string) => {
      root.querySelector(selector)!.textContent = value;
    };
    const setPlayLabel = (label: string) => {
      play.textContent = label;
      play.title = label;
      play.setAttribute("aria-label", label);
    };
    const initialize = () => {
      if (data) return;
      data = bootstrapPromotion();
      const fragment = document.createDocumentFragment();
      dots = data.draws
        .filter((_, index) => index % 20 === 0)
        .map((draw) => {
          const dot = document.createElementNS(
            "http://www.w3.org/2000/svg",
            "circle",
          );
          dot.setAttribute("cx", String(64 + (draw.cost + 50) * 4.64));
          dot.setAttribute(
            "cy",
            String(286 - ((draw.quality + 30) * 254) / 60),
          );
          dot.setAttribute("r", "2.1");
          dot.setAttribute(
            "class",
            draw.passes ? "promotion-draw supports" : "promotion-draw",
          );
          dot.setAttribute("visibility", "hidden");
          fragment.append(dot);
          return dot;
        });
      cloud.append(fragment);
      play.disabled = scrub.disabled = threshold.disabled = false;
    };
    const render = () => {
      if (!data) return;
      root.dataset.drawCount = String(drawCount);
      scrub.value = String(drawCount);
      scrub.setAttribute(
        "aria-valuetext",
        `${drawCount.toLocaleString("en-US")} of 10,000 bootstrap draws`,
      );
      text(
        "[data-promotion-draw-count]",
        `${drawCount.toLocaleString("en-US")} / 10,000`,
      );
      const support = drawCount ? data.supported[drawCount] / drawCount : 0;
      const gamma = Number(threshold.value);
      const complete = drawCount === 10000;
      text("[data-promotion-support]", drawCount ? support.toFixed(2) : "—");
      text("[data-promotion-threshold-value]", gamma.toFixed(2));
      root
        .querySelector<HTMLElement>(".promotion-gate")!
        .style.setProperty("--support", `${support * 100}%`);
      text(
        "[data-promotion-comparison]",
        drawCount
          ? `p̂ ${support.toFixed(2)} ${support >= gamma ? "≥" : "<"} γ ${gamma.toFixed(2)}`
          : "Promote when p̂ ≥ γ",
      );
      const decision = root.querySelector<HTMLElement>(
        "[data-promotion-decision]",
      )!;
      decision.dataset.result = complete
        ? support >= gamma
          ? "promote"
          : "hold"
        : "pending";
      decision.textContent = complete
        ? support >= gamma
          ? "Promote → development"
          : "Do not promote"
        : drawCount
          ? "Estimating support…"
          : "Waiting for evidence";
      const nextVisible = Math.ceil(drawCount / 20);
      for (
        let index = Math.min(visibleDots, nextVisible);
        index < Math.max(visibleDots, nextVisible);
        index++
      ) {
        dots[index].setAttribute(
          "visibility",
          index < nextVisible ? "visible" : "hidden",
        );
      }
      visibleDots = nextVisible;
    };
    const pause = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      playing = false;
      play.dataset.playing = "false";
      setPlayLabel(
        drawCount === 10000 ? "Replay" : drawCount ? "Continue" : "Play",
      );
    };
    const finish = () => {
      pause();
      drawCount = 10000;
      render();
      setPlayLabel("Replay");
      text(
        "[data-promotion-announcement]",
        root.querySelector("[data-promotion-decision]")!.textContent!,
      );
    };
    const tick = (now: number) => {
      drawCount = Math.max(
        0,
        Math.min(10000, Math.floor(((now - start - 350) / 2800) * 10000)),
      );
      render();
      if (drawCount === 10000) finish();
      else frame = requestAnimationFrame(tick);
    };
    const begin = () => {
      initialize();
      hasPlayed = true;
      text("[data-promotion-announcement]", "");
      if (reduced.matches) {
        finish();
        return;
      }
      if (drawCount === 10000) drawCount = 0;
      render();
      playing = true;
      play.dataset.playing = "true";
      start =
        performance.now() - (drawCount ? 350 + (drawCount / 10000) * 2800 : 0);
      setPlayLabel("Pause");
      frame = requestAnimationFrame(tick);
    };
    play.addEventListener("click", () => (playing ? pause() : begin()));
    scrub.addEventListener("input", () => {
      pause();
      hasPlayed = true;
      drawCount = Number(scrub.value);
      render();
      pause();
    });
    threshold.addEventListener("input", () => {
      render();
      if (drawCount === 10000)
        text(
          "[data-promotion-announcement]",
          root.querySelector("[data-promotion-decision]")!.textContent!,
        );
    });
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting && details.open && !hasPlayed) begin();
        else if (!entries[0].isIntersecting && playing) pause();
      },
      { threshold: 0.15 },
    );
    observer.observe(root.querySelector(".promotion-distribution")!);
    details.addEventListener("toggle", () => {
      if (details.open) initialize();
      else pause();
    });
    details.addEventListener("disclosure-closing", pause);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden && playing) pause();
    });
    reduced.addEventListener("change", () => {
      if (reduced.matches && data) finish();
    });
    observeChartTypography(
      root.querySelector<SVGSVGElement>(".promotion-plot")!,
      { compactAxis: { x: -4, y: 159 } },
    );
    setPlayLabel("Play");
    if (details.open) initialize();
  }
</script>

<style>
