      font-size: 15px;
      margin-bottom: 10px;
    }
    .promotion-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
    .promotion-distribution {
      width: 100%;
      max-width: 360px;
      margin: auto;
    }
    .promotion-reading {
      width: 100%;
      max-width: 360px;
      margin: auto;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: 8px 16px;
    }
    .promotion-support-value strong {
      font-size: 18px;
    }
    .promotion-support-value > span {
      font-size: 12px;
    }
    .promotion-conclusion,
    .promotion-settings {
      grid-column: 1 / -1;
      margin-top: 0;
    }
