---
import { results } from "../data/results";
import PublicationTable from "./PublicationTable.astro";
import ResultValue from "./ResultValue.astro";

const figure = `${import.meta.env.BASE_URL}figures/quality-cost-frontiers.svg`;
const rows = results.map((result) => ({
  ...result,
  columns: [result.cm, result.gaia, ...result.universes],
}));
const emphasis = (column: number, metric: 0 | 2, value: number) => {
  const ranked = [
    ...new Set(rows.map((row) => row.columns[column][metric])),
  ].sort((a, b) => (metric === 0 ? b - a : a - b));
  if (value === ranked[0]) return "best" as const;
  if (value === ranked[1]) return "second" as const;
  return undefined;
};
---

<div class="results-publication">
  <figure class="results-figure">
    <div
      class="results-figure-scroll"
      role="region"
      aria-label="Development quality–cost comparison on both benchmarks"
      tabindex="0"
    >
      <img
        src={figure}
        width="1200"
        height="531"
        loading="lazy"
        alt="Development quality–cost trajectories for ClawMark and GAIA2, comparing ParetoSaddler, quality-only AutoSaddler, and Meta-Harness. Stars mark the initial harnesses; larger outlined markers identify the final candidates."
      />
    </div>
    <figcaption>
      Development quality–cost trajectories on ClawMark and GAIA2. Larger
      outlined markers show the final candidates; better operating points lie
      toward the upper left.
    </figcaption>
  </figure>

  <h3 class="publication-heading">Test Results</h3>
  <PublicationTable
    id="main-results-table"
    label="Held-out test results on ClawMark and GAIA2, including GAIA2 universe-level results"
    wide
  >
    <colgroup>
      <col class="method-column" />
      <col class="metric-column" />
      <col span="2" class="overall-column" />
      <col span="3" class="universe-column" />
    </colgroup>
    <thead>
      <tr>
        <th rowspan="2" scope="col">Setting</th>
        <th rowspan="2" scope="col" class="metric-heading">Metric</th>
        <th colspan="2" scope="colgroup" class="overall-heading">Overall</th>
        <th colspan="3" scope="colgroup" class="group-start universe-heading"
          >GAIA2 by Universe</th
        >
      </tr>
      <tr>
        <th scope="col">ClawMark</th>
        <th scope="col">GAIA2</th>
        <th scope="col" class="group-start universe-heading">U21 (107)</th>
        <th scope="col" class="universe-heading">U22 (112)</th>
        <th scope="col" class="universe-heading">U27 (81)</th>
      </tr>
    </thead>
    {
      rows.map((row) => (
        <tbody
          class:list={{ "is-ours": row.family === "ps" }}
          data-method={row.id}
        >
          {([0, 2] as const).map((metric) => (
            <tr>
              {metric === 0 && (
                <th rowspan="2" scope="rowgroup" class="method-label">
                  {row.label}
                  {row.endpoint && <sup>{row.endpoint}</sup>}
                </th>
              )}
              <th scope="row" class="metric-label">
                {metric === 0 ? "Qual. ↑" : "Cost ↓"}
              </th>
              {row.columns.map((values, column) => (
                <td class:list={{
                  "group-start": column === 2,
                  "overall-result": column < 2,
                  "universe-result": column >= 2,
                }}>
                  <ResultValue
                    mean={values[metric]}
                    deviation={values[metric + 1]}
                    emphasis={emphasis(column, metric, values[metric])}
                    alignDecimals
                  />
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      ))
    }
  </PublicationTable>
  <p class="publication-note">
    Quality is reported in %, cost in USD per task. Values are mean ± sample
    standard deviation over three test repeats. Bold and underlined means mark
    the best and second-best displayed results. Superscripts Q and C identify
    the quality- and cost-extreme harnesses selected on development data.
  </p>
</div>
