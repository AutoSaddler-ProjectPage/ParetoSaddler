---
import { trajectories } from "../data/trajectories";
import "../styles/trajectory.css";
const base = import.meta.env.BASE_URL;
---

<div
  class="trajectory-explorer"
  id="trajectory-explorer"
  tabindex="0"
  role="region"
  aria-label="Animated optimization trajectories. Use left and right arrow keys to step through proposals."
>
  <div class="trajectory-toolbar">
    <div
      class="benchmark-switch"
      role="group"
      aria-label="Select optimization run"
    >
      <button type="button" data-trajectory-benchmark="cm" aria-pressed="true"
        >ClawMark</button
      >
      <button
        type="button"
        data-trajectory-benchmark="gaia"
        aria-pressed="false">GAIA2</button
      >
    </div>
    <span id="trajectory-run-description"
      >17 proposals · 20 development tasks · 3 runs/task</span
    >
  </div>
  <div class="trajectory-playback trajectory-top-playback">
    <button
      type="button"
      id="trajectory-prev"
      aria-label="Previous iteration"
      disabled>← Prev</button
    >
    <button type="button" id="trajectory-play" aria-pressed="false"
      >▶ Play</button
    >
    <button type="button" id="trajectory-next" aria-label="Next iteration"
      >Next →</button
    >
    <button
      type="button"
      id="trajectory-reset"
      aria-label="Restart from the initial harness">↺ Reset</button
    >
    <label class="trajectory-speed"
      >Speed <select id="trajectory-speed"
        ><option value="3000">0.5×</option><option value="1800" selected
          >1×</option
        ><option value="900">2×</option></select
      ></label
    >
  </div>
  <div class="trajectory-body">
    <div class="trajectory-chart-column">
      <div class="trajectory-chart-heading">
        <div>
          <p class="trajectory-chart-kicker">THE SEARCH, STEP BY STEP</p><h3
            id="trajectory-chart-heading"
          >
            ClawMark · development
          </h3>
        </div><span id="trajectory-view-state">Initial harness</span>
      </div>
      <svg
        class="trajectory-chart"
        viewBox="0 0 760 450"
        role="group"
        aria-labelledby="trajectory-chart-title trajectory-chart-desc"
      >
        <title id="trajectory-chart-title">
          ClawMark optimization, iteration by iteration
        </title>
        <desc id="trajectory-chart-desc"
          >Quality versus cost on the development set. Solid arrows show
          continued harness refinement; dashed lines show the Pareto set at the
          displayed iteration. Select a marker or use the timeline below.</desc
        >
        <defs
          ><marker
            id="trajectory-arrow"
            viewBox="0 0 10 10"
            refX="9"
            refY="5"
            markerWidth="5"
            markerHeight="5"
            orient="auto-start-reverse"
            ><path d="M 0 0 L 10 5 L 0 10 z" fill="#24734b"></path></marker
          ></defs
        >
        <rect x="78" y="35" width="636" height="325" fill="#fbfcfa"></rect>
        <g id="trajectory-grid"></g>
        <path d="M78 35V360H714" class="plot-axis"></path>
        <text
          class="trajectory-axis-title"
          transform="translate(23 197) rotate(-90)"
          text-anchor="middle">Development quality (%) ↑</text
        >
        <text class="trajectory-axis-title" x="396" y="425" text-anchor="middle"
          >LLM cost per task (USD) ↓</text
        >
        <g id="trajectory-edges"></g>
        <path id="trajectory-frontier" class="trajectory-frontier" fill="none"
        ></path>
        <g id="trajectory-label-leaders" aria-hidden="true"></g>
        <g id="trajectory-points"></g>
        <g id="trajectory-labels" aria-hidden="true"></g>
        <circle
          id="trajectory-traveler"
          r="5.5"
          visibility="hidden"
          aria-hidden="true"></circle>
        <text
          id="trajectory-rejection-note"
          x="396"
          y="18"
          text-anchor="middle"
          visibility="hidden"></text>
      </svg>
      <div class="trajectory-legend">
        <span>● Continued refinement</span><span class="muted-marker"
          >● Other evaluated candidate</span
        ><span class="frontier-legend">┄ Current Pareto set</span>
      </div>
      <div class="trajectory-bottom-strip">
        <div class="trajectory-archive">
          <span>Current dev Pareto set</span><div
            id="trajectory-archive-members"
          >
          </div>
        </div>
        <div class="trajectory-counts">
          <span><strong id="trajectory-promoted-count">0</strong> promoted</span
          ><span
            ><strong id="trajectory-rejected-count">0</strong> rejected</span
          ><span
            ><strong id="trajectory-pareto-count">1</strong> on current frontier</span
          >
        </div>
      </div>
    </div>
    <aside class="trajectory-detail" aria-labelledby="trajectory-step-title">
      <div class="trajectory-summary">
        <div class="trajectory-step-heading">
          <span id="trajectory-step-label">Initial harness</span><span
            id="trajectory-final-status"
            class="trajectory-status">Baseline</span
          >
        </div>
        <h3 id="trajectory-step-title">Initial harness</h3>
        <dl class="trajectory-metrics">
          <div>
            <dt>Dev quality ↑</dt><dd id="trajectory-quality">≈66.13%</dd>
          </div><div>
            <dt>Cost / task ↓</dt><dd id="trajectory-cost">≈$1.45</dd>
          </div>
        </dl>
        <p id="trajectory-movement">Before optimization</p>
      </div>
      <div class="trajectory-explanation">
        <h4>Diagnosed issue</h4><p id="trajectory-diagnosis">
          The starting point before ParetoSaddler optimization.
        </p>
      </div>
      <div class="trajectory-explanation">
        <h4>Harness update</h4><p id="trajectory-change">
          Prompts, tools, middleware, and control logic have not yet been
          updated by this run.
        </p>
      </div>
      <p class="trajectory-status-note">
        Status labels describe the <em>final</em> development archive. The chart’s
        dashed frontier updates at every step.
      </p>
    </aside>
  </div>
  <div class="trajectory-controls">
    <div class="trajectory-scrubber">
      <label for="trajectory-iteration" id="trajectory-progress"
        >Initial / 17 proposals</label
      ><input
        id="trajectory-iteration"
        type="range"
        min="0"
        max="17"
        value="0"
        step="1"
        aria-valuetext="Initial harness"
      />
    </div>
    <div
      class="trajectory-timeline"
      id="trajectory-timeline"
      role="group"
      aria-label="Jump to an iteration"
    >
      {
        trajectories.cm.steps.map((step) => (
          <button
            type="button"
            data-iteration={step.iteration}
            aria-label={
              step.iteration === 0
                ? "Initial harness"
                : `Iteration ${step.iteration}: ${step.title}`
            }
            aria-pressed={step.iteration === 0 ? "true" : "false"}
          >
            {step.iteration === 0 ? "Start" : step.iteration}
          </button>
        ))
      }
    </div>
    <p class="trajectory-control-hint">
      Play the run, drag the slider, or select an iteration. Use ← / → while
      this explorer is focused.
    </p>
  </div>
  <p
    id="trajectory-announcement"
    class="sr-only"
    role="status"
    aria-live="polite"
  >
  </p>
</div>
<p class="trajectory-source">
  Development trajectories from Appendix H, Figures 7–8; diagnoses and updates
  from Tables 12 and 15. <strong>≈</strong> marks estimates recovered from the plotted
  coordinates. Rejected proposals have no development point. <a
    id="trajectory-paper-link"
    href={`${base}paretosaddler.pdf#page=22`}
    target="_blank"
    rel="noopener noreferrer">View original in paper ↗</a
  >
</p>
<noscript
  ><p>
    Enable JavaScript to play the optimization runs, or read the complete
    trajectories in <a href={`${base}paretosaddler.pdf#page=22`}
      >Appendices H–J of the paper</a
    >.
  </p></noscript
>
<script>
  import {
    trajectories,
    frontierAt,
    type TrajectoryBenchmark,
    type TrajectoryStep,
  } from "../data/trajectories";
  import {
    placeTrajectoryLabels,
    type LabelBox,
    type ChartPoint,
  } from "../lib/trajectory-labels";
  const host = document.querySelector<HTMLElement>("#trajectory-explorer");
  if (host) {
    const root = host;
    const svgNS = "http://www.w3.org/2000/svg";
    const motionPreference = matchMedia("(prefers-reduced-motion: reduce)");
    let benchmark: TrajectoryBenchmark = "cm";
    let iteration = 0;
    let playing = false;
    let timer: ReturnType<typeof setInterval> | undefined;
    const points = new Map<number, SVGGElement>();
    const edges = new Map<number, SVGPathElement>();
    const labelPositions = new Map<number, LabelBox>();
    let hoveredIteration: number | null = null;
    let focusedIteration: number | null = null;
    let lastRendered = -1;
    let frame: number | undefined;
    let activeMotion: Animation[] = [];
    let currentFrontier = new Set<number>();
    const required = <T extends Element>(selector: string) =>
      root.querySelector<T>(selector)!;
    const text = (selector: string, value: string) => {
      required(selector).textContent = value;
    };
    const currentRun = () => trajectories[benchmark];
    const x = (value: number) =>
      78 +
      ((value - currentRun().xDomain[0]) /
        (currentRun().xDomain[1] - currentRun().xDomain[0])) *
        636;
    const y = (value: number) =>
      360 -
      ((value - currentRun().yDomain[0]) /
        (currentRun().yDomain[1] - currentRun().yDomain[0])) *
        325;
    const createSVG = <K extends keyof SVGElementTagNameMap>(
      tag: K,
      attributes: Record<string, string | number>,
    ) => {
      const node = document.createElementNS(svgNS, tag);
      for (const [key, value] of Object.entries(attributes))
        node.setAttribute(key, String(value));
      return node;
    };
    const stepName = (step: TrajectoryStep) =>
      step.iteration === 0 ? "Initial" : `I-${step.iteration}`;
    const stopMotion = () => {
      if (frame !== undefined) cancelAnimationFrame(frame);
      frame = undefined;
      activeMotion.forEach((animation) => animation.cancel());
      activeMotion = [];
      required("#trajectory-traveler").setAttribute("visibility", "hidden");
    };
    const layoutAnnotations = () => {
      const run = currentRun();
      const layer = required("#trajectory-labels");
      const leaders = required("#trajectory-label-leaders");
      layer.replaceChildren();
      leaders.replaceChildren();
      const visible = run.steps.filter(
        (step) =>
          step.iteration <= iteration &&
          step.cost !== null &&
          step.quality !== null,
      );
      const obstacles: ChartPoint[] = visible.map((step) => ({
        id: step.iteration,
        x: x(step.cost!),
        y: y(step.quality!),
      }));
      const ids = [
        ...new Set([
          iteration,
          hoveredIteration,
          focusedIteration,
          ...currentFrontier,
          0,
        ]),
      ].filter(
        (id): id is number =>
          id !== null && visible.some((step) => step.iteration === id),
      );
      const groups = new Map<number, SVGGElement>();
      const targets = ids.map((id) => {
        const step = run.steps[id];
        const group = createSVG("g", {
          class: "trajectory-annotation",
          "data-trajectory-label": id,
          "data-kind":
            id === iteration
              ? "current"
              : currentFrontier.has(id)
                ? "frontier"
                : id === 0
                  ? "initial"
                  : "inspection",
        });
        const label = createSVG("text", {
          class: "trajectory-annotation-text",
          x: 0,
          y: 0,
        });
        label.textContent = stepName(step);
        group.append(label);
        layer.append(group);
        groups.set(id, group);
        const box = label.getBBox();
        return {
          id,
          x: x(step.cost!),
          y: y(step.quality!),
          width: Math.ceil(box.width) + 22,
          height: Math.max(28, Math.ceil(box.height) + 12),
        };
      });
      const placements = placeTrajectoryLabels(
        targets,
        obstacles,
        { x: 87, y: 48, width: 618, height: 299 },
        labelPositions,
      );
      for (const placement of placements) {
        const group = groups.get(placement.id)!;
        const box = placement.box;
        group.prepend(
          createSVG("rect", {
            x: box.x,
            y: box.y,
            width: box.width,
            height: box.height,
            rx: 7,
            class: "trajectory-annotation-box",
          }),
        );
        const label = group.querySelector("text")!;
        label.setAttribute("x", String(box.x + box.width / 2));
        label.setAttribute("y", String(box.y + box.height / 2));
        label.setAttribute("text-anchor", "middle");
        label.setAttribute("dominant-baseline", "central");
        leaders.append(
          createSVG("path", {
            d: `M${placement.start.x} ${placement.start.y} L${placement.end.x} ${placement.end.y}`,
            class: `trajectory-annotation-leader ${placement.id === iteration ? "is-current" : ""}`,
          }),
        );
        labelPositions.set(placement.id, box);
      }
    };
    const animateStep = (previous: number) => {
      if (motionPreference.matches || previous < 0 || previous === iteration)
        return;
      const summary = required<HTMLElement>(".trajectory-summary");
      activeMotion.push(
        summary.animate([{ opacity: 0.45 }, { opacity: 1 }], {
          duration: 350,
          easing: "ease-out",
        }),
      );
      const point = points.get(iteration);
      if (point)
        activeMotion.push(
          point.animate([{ opacity: 0.2 }, { opacity: 1 }], { duration: 600 }),
        );
      const frontier = required<SVGPathElement>("#trajectory-frontier");
      activeMotion.push(
        frontier.animate([{ opacity: 0.15 }, { opacity: 0.85 }], {
          duration: 650,
        }),
      );
      const edge = edges.get(iteration);
      if (!edge) return;
      const duration = Math.min(
        850,
        Number(required<HTMLSelectElement>("#trajectory-speed").value) * 0.65,
      );
      activeMotion.push(
        edge.animate(
          [
            { strokeDasharray: "1", strokeDashoffset: "1" },
            { strokeDasharray: "1", strokeDashoffset: "0" },
          ],
          { duration, easing: "cubic-bezier(.22,.61,.36,1)" },
        ),
      );
      const traveler = required<SVGCircleElement>("#trajectory-traveler");
      const length = edge.getTotalLength();
      const started = performance.now();
      traveler.setAttribute("visibility", "visible");
      const advance = (now: number) => {
        const progress = Math.min(1, (now - started) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        const position = edge.getPointAtLength(eased * length);
        traveler.setAttribute("cx", String(position.x));
        traveler.setAttribute("cy", String(position.y));
        traveler.style.opacity = String(Math.sin(Math.PI * progress));
        if (progress < 1) frame = requestAnimationFrame(advance);
        else {
          frame = undefined;
          traveler.setAttribute("visibility", "hidden");
        }
      };
      frame = requestAnimationFrame(advance);
    };
    const pause = () => {
      stopMotion();
      playing = false;
      root.dataset.playing = "false";
      clearInterval(timer);
      timer = undefined;
      text("#trajectory-play", "▶ Play");
      required("#trajectory-play").setAttribute("aria-pressed", "false");
    };
    const render = (announce = false) => {
      stopMotion();
      const run = currentRun();
      const step = run.steps[iteration];
      const frontier = frontierAt(run.steps, iteration);
      const frontierIds = new Set(frontier.map((s) => s.iteration));
      currentFrontier = frontierIds;
      for (const candidate of run.steps) {
        const point = points.get(candidate.iteration);
        if (point) {
          const visible = candidate.iteration <= iteration;
          point.classList.toggle("is-hidden", !visible);
          // Gate SVG rendering directly: presentation opacity must not reveal future steps.
          point.setAttribute("visibility", visible ? "visible" : "hidden");
          point.setAttribute("aria-hidden", String(!visible));
          point.setAttribute("tabindex", visible ? "0" : "-1");
          point.classList.toggle(
            "is-current",
            candidate.iteration === iteration,
          );
          point.classList.toggle(
            "on-frontier",
            frontierIds.has(candidate.iteration),
          );
          point.setAttribute(
            "aria-pressed",
            String(candidate.iteration === iteration),
          );
        }
        const edge = edges.get(candidate.iteration);
        if (edge) {
          const visible = candidate.iteration <= iteration;
          edge.classList.toggle("is-hidden", !visible);
          edge.setAttribute("visibility", visible ? "visible" : "hidden");
          edge.setAttribute("aria-hidden", String(!visible));
          edge.classList.toggle("is-latest", candidate.iteration === iteration);
        }
      }
      required("#trajectory-frontier").setAttribute(
        "d",
        frontier
          .map((s, i) => `${i ? "L" : "M"}${x(s.cost!)} ${y(s.quality!)}`)
          .join(" "),
      );
      const rejected = step.finalStatus === "Rejected";
      const note = required("#trajectory-rejection-note");
      note.setAttribute("visibility", rejected ? "visible" : "hidden");
      note.textContent = `${stepName(step)} rejected · no development evaluation`;
      text(
        "#trajectory-step-label",
        iteration
          ? `ITERATION ${iteration} / ${run.proposals}`
          : "INITIAL HARNESS",
      );
      text("#trajectory-step-title", step.title);
      text(
        "#trajectory-final-status",
        step.finalStatus === "Pareto"
          ? "Final Pareto set"
          : step.finalStatus === "Dominated"
            ? "Later dominated"
            : rejected
              ? "Rejected"
              : "Baseline",
      );
      required("#trajectory-final-status").setAttribute(
        "data-status",
        step.finalStatus.toLowerCase(),
      );
      text(
        "#trajectory-quality",
        step.quality === null ? "—" : `≈${step.quality.toFixed(2)}%`,
      );
      text(
        "#trajectory-cost",
        step.cost === null ? "—" : `≈$${step.cost.toFixed(2)}`,
      );
      text("#trajectory-diagnosis", step.diagnosis);
      text("#trajectory-change", step.change);
      if (rejected)
        text(
          "#trajectory-movement",
          "Not promoted. No full-development evaluation or plotted quality–cost estimate.",
        );
      else if (step.continuedFrom !== null) {
        const parent = run.steps[step.continuedFrom];
        const dq = step.quality! - parent.quality!,
          dc = step.cost! - parent.cost!;
        text(
          "#trajectory-movement",
          `From ${stepName(parent)}: ${dq < 0 ? "−" : "+"}${Math.abs(dq).toFixed(2)} pp quality · ${dc < 0 ? "−" : "+"}$${Math.abs(dc).toFixed(Math.abs(dc) > 0 && Math.abs(dc) < 0.01 ? 3 : 2)} / task (≈)`,
        );
      } else
        text(
          "#trajectory-movement",
          iteration
            ? "Evaluated candidate; not on the continued-refinement path in the annotated figure."
            : "Before optimization",
        );
      text(
        "#trajectory-progress",
        iteration
          ? `Iteration ${iteration} / ${run.proposals}`
          : `Initial / ${run.proposals} proposals`,
      );
      const slider = required<HTMLInputElement>("#trajectory-iteration");
      slider.value = String(iteration);
      slider.setAttribute("aria-valuetext", `${stepName(step)}: ${step.title}`);
      required<HTMLButtonElement>("#trajectory-prev").disabled =
        iteration === 0;
      required<HTMLButtonElement>("#trajectory-next").disabled =
        iteration === run.proposals;
      for (const button of root.querySelectorAll<HTMLButtonElement>(
        "[data-iteration]",
      )) {
        const number = Number(button.dataset.iteration),
          s = run.steps[number];
        button.setAttribute("aria-pressed", String(number === iteration));
        button.classList.toggle("is-past", number < iteration);
        button.classList.toggle(
          "is-rejected",
          number <= iteration && s.finalStatus === "Rejected",
        );
        button.classList.toggle("is-frontier", frontierIds.has(number));
      }
      const members = required("#trajectory-archive-members");
      members.replaceChildren();
      for (const member of frontier) {
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = stepName(member);
        button.setAttribute(
          "aria-label",
          `Inspect ${stepName(member)} on the current frontier`,
        );
        button.addEventListener("click", () => goTo(member.iteration));
        members.append(button);
      }
      const seen = run.steps.slice(1, iteration + 1);
      text(
        "#trajectory-promoted-count",
        String(seen.filter((s) => s.quality !== null).length),
      );
      text(
        "#trajectory-rejected-count",
        String(seen.filter((s) => s.finalStatus === "Rejected").length),
      );
      text("#trajectory-pareto-count", String(frontier.length));
      text(
        "#trajectory-view-state",
        step.finalStatus === "Rejected"
          ? `I-${iteration} · screened out`
          : iteration
            ? `Iteration ${iteration} / ${run.proposals}`
            : "Initial harness",
      );
      layoutAnnotations();
      animateStep(lastRendered);
      lastRendered = iteration;
      if (announce)
        text(
          "#trajectory-announcement",
          `${run.name}. ${stepName(step)}. ${step.title}. ${step.finalStatus === "Rejected" ? "Rejected; no development evaluation." : `Development quality approximately ${step.quality} percent, cost approximately ${step.cost} dollars per task.`}`,
        );
    };
    const goTo = (value: number) => {
      pause();
      iteration = Math.max(0, Math.min(currentRun().proposals, value));
      render(true);
    };
    const start = () => {
      if (iteration === currentRun().proposals) iteration = 0;
      pause();
      playing = true;
      root.dataset.playing = "true";
      text("#trajectory-play", "Ⅱ Pause");
      required("#trajectory-play").setAttribute("aria-pressed", "true");
      render();
      timer = setInterval(
        () => {
          iteration++;
          render();
          if (iteration === currentRun().proposals) {
            pause();
            text(
              "#trajectory-announcement",
              `${currentRun().name} run complete. Final Pareto archive: ${currentRun()
                .archive.map((i) => `I-${i}`)
                .join(", ")}.`,
            );
          }
        },
        Number(required<HTMLSelectElement>("#trajectory-speed").value),
      );
    };
    const buildChart = () => {
      const run = currentRun();
      points.clear();
      edges.clear();
      labelPositions.clear();
      hoveredIteration = null;
      focusedIteration = null;
      lastRendered = -1;
      const grid = required("#trajectory-grid"),
        pointLayer = required("#trajectory-points"),
        edgeLayer = required("#trajectory-edges");
      grid.replaceChildren();
      pointLayer.replaceChildren();
      edgeLayer.replaceChildren();
      for (const tick of run.xTicks) {
        const line = createSVG("line", {
          x1: x(tick),
          x2: x(tick),
          y1: 35,
          y2: 360,
        });
        const label = createSVG("text", {
          x: x(tick),
          y: 390,
          "text-anchor": "middle",
        });
        label.textContent = `$${tick.toFixed(1)}`;
        grid.append(line, label);
      }
      for (const tick of run.yTicks) {
        const line = createSVG("line", {
          x1: 78,
          x2: 714,
          y1: y(tick),
          y2: y(tick),
        });
        const label = createSVG("text", {
          x: 63,
          y: y(tick) + 6,
          "text-anchor": "end",
        });
        label.textContent = String(tick);
        grid.append(line, label);
      }
      for (const step of run.steps) {
        if (step.quality === null || step.cost === null) continue;
        const cx = x(step.cost),
          cy = y(step.quality);
        if (step.continuedFrom !== null) {
          const parent = run.steps[step.continuedFrom];
          const px = x(parent.cost!),
            py = y(parent.quality!);
          const dx = cx - px,
            dy = cy - py;
          const length = Math.hypot(dx, dy) || 1;
          const startGap = Math.min(10, length * 0.25);
          const endGap = Math.min(12, length * 0.25);
          const edge = createSVG("path", {
            d: `M${px + (dx / length) * startGap} ${py + (dy / length) * startGap} L${cx - (dx / length) * endGap} ${cy - (dy / length) * endGap}`,
            class: "trajectory-edge is-hidden",
            visibility: "hidden",
            pathLength: 1,
            "marker-end": "url(#trajectory-arrow)",
          });
          edgeLayer.append(edge);
          edges.set(step.iteration, edge);
        }
        const point = createSVG("g", {
          transform: `translate(${cx} ${cy})`,
          class: `trajectory-point ${step.iteration === 0 ? "initial" : step.continuedFrom === null ? "other-candidate" : "continued-candidate"}`,
          role: "button",
          tabindex: 0,
          visibility: step.iteration === 0 ? "visible" : "hidden",
          "data-trajectory-point": step.iteration,
          "aria-label": `${stepName(step)}: ${step.title}. Quality approximately ${step.quality} percent; cost approximately ${step.cost} dollars.`,
        });
        point.append(
          createSVG("circle", { r: 17, class: "trajectory-point-target" }),
          createSVG("circle", { r: 13, class: "trajectory-point-ring" }),
        );
        point.append(
          step.iteration === 0
            ? createSVG("path", {
                d: "M0 -10L3 -3L10 0L3 3L0 10L-3 3L-10 0L-3 -3Z",
                class: "trajectory-point-symbol",
              })
            : createSVG("circle", { r: 6.5, class: "trajectory-point-symbol" }),
        );
        point.addEventListener("pointerenter", () => {
          hoveredIteration = step.iteration;
          layoutAnnotations();
        });
        point.addEventListener("pointerleave", () => {
          hoveredIteration = null;
          layoutAnnotations();
        });
        point.addEventListener("focus", () => {
          focusedIteration = step.iteration;
          layoutAnnotations();
        });
        point.addEventListener("blur", () => {
          focusedIteration = null;
          layoutAnnotations();
        });
        point.addEventListener("click", () => goTo(step.iteration));
        point.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            goTo(step.iteration);
          }
        });
        pointLayer.append(point);
        points.set(step.iteration, point);
      }
      const timeline = required("#trajectory-timeline");
      timeline.replaceChildren();
      for (const step of run.steps) {
        const button = document.createElement("button");
        button.type = "button";
        button.dataset.iteration = String(step.iteration);
        button.textContent = step.iteration ? String(step.iteration) : "Start";
        button.setAttribute("aria-label", `${stepName(step)}: ${step.title}`);
        button.addEventListener("click", () => goTo(step.iteration));
        timeline.append(button);
      }
      required<HTMLInputElement>("#trajectory-iteration").max = String(
        run.proposals,
      );
      text("#trajectory-chart-heading", `${run.name} · development`);
      text(
        "#trajectory-chart-title",
        `${run.name} optimization, iteration by iteration`,
      );
      text(
        "#trajectory-run-description",
        `${run.proposals} proposals · ${run.tasks} development tasks · 3 runs/task`,
      );
      const link = document.querySelector<HTMLAnchorElement>(
        "#trajectory-paper-link",
      );
      if (link) link.hash = `page=${run.page}`;
      for (const button of root.querySelectorAll<HTMLButtonElement>(
        "[data-trajectory-benchmark]",
      ))
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.trajectoryBenchmark === benchmark),
        );
      render();
    };
    required("#trajectory-prev").addEventListener("click", () =>
      goTo(iteration - 1),
    );
    required("#trajectory-next").addEventListener("click", () =>
      goTo(iteration + 1),
    );
    required("#trajectory-reset").addEventListener("click", () => goTo(0));
    required("#trajectory-play").addEventListener("click", () => {
      playing ? pause() : start();
    });
    required("#trajectory-iteration").addEventListener("input", (event) =>
      goTo(Number((event.target as HTMLInputElement).value)),
    );
    required("#trajectory-speed").addEventListener("change", () => {
      if (playing) start();
    });
    for (const button of root.querySelectorAll<HTMLButtonElement>(
      "[data-trajectory-benchmark]",
    ))
      button.addEventListener("click", () => {
        pause();
        benchmark = button.dataset.trajectoryBenchmark as TrajectoryBenchmark;
        iteration = 0;
        buildChart();
        text(
          "#trajectory-announcement",
          `Showing ${currentRun().name}, ${currentRun().proposals} proposals.`,
        );
      });
    root.addEventListener("keydown", (event) => {
      if (
        (event.target as HTMLElement).matches("input,select") ||
        event.altKey ||
        event.ctrlKey ||
        event.metaKey
      )
        return;
      if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
        event.preventDefault();
        goTo(iteration + (event.key === "ArrowRight" ? 1 : -1));
      }
    });
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries[0].isIntersecting;
        if (!visible) pause();
      },
      { threshold: 0.2 },
    );
    observer.observe(root);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) pause();
    });
    motionPreference.addEventListener("change", () => {
      if (motionPreference.matches) pause();
    });
    buildChart();
    document.fonts.ready.then(layoutAnnotations);
    new ResizeObserver(() => {
      labelPositions.clear();
      layoutAnnotations();
    }).observe(required(".trajectory-chart"));
  }
</script>
