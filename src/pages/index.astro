---
import { Font } from "astro:assets";
import "../styles/global.css";
import { Content, frontmatter } from "../paper.mdx";
const { title, description, favicon, thumbnail } = frontmatter;
const base = import.meta.env.BASE_URL;
const canonical = Astro.site ? new URL(base, Astro.site).href : undefined;
const socialImage = Astro.site
  ? new URL(`${base}${thumbnail}`, Astro.site).href
  : `${base}${thumbnail}`;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#24734b" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}${favicon}`} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="ParetoSaddler — agent harness optimization for higher quality and lower cost"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <Font
      cssVariable="--font-noto-sans"
      preload={[{ subset: "latin", style: "normal" }]}
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main"><Content /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <a class="footer-brand" href="#top">ParetoSaddler</a><p>
            Higher quality. Lower cost. Better harnesses.
          </p>
        </div>
        <nav aria-label="Related research">
          <span>THE SADDLER SERIES</span><a
            href="https://autosaddler-projectpage.github.io/">AutoSaddler ↗</a
          ><a href="https://autosaddler-projectpage.github.io/activesaddler/"
            >ActiveSaddler ↗</a
          ><a href="#top" aria-current="page">ParetoSaddler</a>
        </nav>
      </div>
      <div class="footer-bottom">
        <span>Research preprint · 2026</span><p>
          Built on <a
            href="https://research-template.roman.technology"
            rel="nofollow">Roman Hauksson-Neill’s project page template</a
          >.
        </p><a href="#top">Back to top ↑</a>
      </div>
    </footer>
  </body>
</html>
